{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "__test__"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["vitest/config", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"],
      "vuex": ["./node_modules/vuex/types"] // fix vuex pnpm issue
    }
  }
}
